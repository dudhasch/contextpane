    "@contextpane/mcp-erp": "workspace:*",
    "@contextpane/mcp-msgraph": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "diff": "^9.0.0",
    "hono": "^4.13.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
