{
  "name": "@contextpane/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "ContextPane orchestrator: Bun + Hono backend with the 4-Tier Meta Model Router, SSE progress streams and WebSocket telemetry.",
  "license": "MIT",
  "type": "module",
  "scripts": {
