{
  "$comment": "One rule set for both pre-flight sandboxes: apps/orchestrator/src/preflight/local.ts (via packages/catalog/src/preflight-rules.ts) and modal-sandbox/contextpane_sandbox.py (copied into the Modal image). Every rule here is a hard failure. Command names are lower-case; destructivePatterns are case-insensitive regular expressions valid in both JavaScript and Python. deniedExecutionCommands are applied by the execution-surface rules (apps/orchestrator/src/preflight/execution-surface.ts) to the AST report of either sandbox. The executor connects before the script runs (apps/orchestrator/src/execution/executor-identity.ts), so a script that signs in again would replace that identity: Connect-/Disconnect- of Graph and Az are denied too.",
  "allowedVerbs": [
    "Get",
    "Set",
    "Update",
    "New",
    "Add",
    "Connect",
    "Select",
    "Where",
    "ForEach",
    "Write",
    "Out",
    "Test",
    "ConvertTo",
    "ConvertFrom",
    "Format",
    "Measure",
    "Sort",
    "Group",
    "Start",
    "Import",
    "Compare",
    "Join",
    "Split",
    "Undo",
    "Restore",
    "Enable",
    "Disable",
    "Sync",
    "Invoke",
    "Revoke"
  ],
  "allowedCommands": [
    "remove-mggroupmemberbyref",
    "new-mggroupmemberbyref",
    "invoke-mglicenseuser",
    "invoke-mggraphrequest",
    "sync-mgdevicemanagementmanageddevice",
    "new-mgbetadevicemanagementdevicehealthscript",
    "new-mgsitepermission",
    "remove-mgapplicationownerbyref",
    "remove-mgoauth2permissiongrant",
    "remove-mgserviceprincipalapproleassignment",
    "remove-mgapplicationpassword",
    "remove-mgapplicationfederatedidentitycredential",
    "remove-azkeyvault",
    "remove-aznetworksecurityruleconfig"
  ],
  "forbiddenCommands": [
