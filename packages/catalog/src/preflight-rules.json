    "iex",
    "remove-mguser",
    "remove-mggroup",
    "remove-azresourcegroup",
    "remove-item",
    "start-process",
    "invoke-webrequest",
    "invoke-restmethod",
    "set-executionpolicy"
  ],
  "destructivePatterns": [
    "\\bRemove-MgUser\\s+-All\\b",
    "\\bRemove-AzResource\\b(?![^\\n]*-(?:ResourceId|Name|ResourceName))\\s+-Force\\b",
    "\\bFormat-Volume\\s+-Force\\b"
  ],
  "deniedExecutionCommands": [
