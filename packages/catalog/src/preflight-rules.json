  "destructivePatterns": [
    "\\bRemove-MgUser\\s+-All\\b",
    "\\bRemove-AzResource\\b(?![^\\n]*-(?:ResourceId|Name|ResourceName))\\s+-Force\\b",
    "\\bFormat-Volume\\s+-Force\\b"
  ]
}
