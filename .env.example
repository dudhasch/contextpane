# ---------------------------------------------------------------------------
# ContextPane — environment template
# Copy to .env.local (git-ignored) or run: pwsh ./scripts/Set-ContextPaneRouterConfig.ps1
# Every key is optional. With no keys set, every tier falls back to the
# deterministic local engine, so the workbench works out of the box.
# ---------------------------------------------------------------------------

# --- Ports -----------------------------------------------------------------
CTX_ORCHESTRATOR_PORT=4000
CTX_WEB_PORT=5173
# 127.0.0.1 on purpose: on Windows "localhost" resolves to ::1 first and the IPv6 fallback costs ~2 s per request
CTX_ORCHESTRATOR_URL=http://127.0.0.1:4000

# --- Cloud mode ------------------------------------------------------------
# true  -> mcp-msgraph / mcp-azure-iac read Microsoft Graph ($batch) and ARM with fetch(), using
#          bearer tokens minted once from the cached Connect-AzAccount sign-in (one pwsh run per
#          resource, kept in memory for up to 45 min). The context is cached per tenant (30 s fresh,
#          then stale-while-revalidate); ?refresh=true on any endpoint bypasses it.
# false -> read ./demo-iac/demo-lab-manifest.json (deterministic, offline-safe)
LIVE_CLOUD_MODE=false
# Per-request budgets for the live Graph / ARM reads (ms); a failed read falls back to the manifest
CTX_GRAPH_TIMEOUT_MS=25000
CTX_AZ_TIMEOUT_MS=25000
# auditLogs/signIns (40-60 s filtered by UPN) only runs as a background probe with this budget; until it
# finds events the timeline is the seeded one re-keyed to the live Conditional Access policy
CTX_GRAPH_SIGNIN_TIMEOUT_MS=60000
# Path override for the offline manifest (defaults to <repo>/demo-iac/demo-lab-manifest.json)
# CTX_DEMO_MANIFEST=
# Path override for the Terraform baseline directory (defaults to <repo>/demo-iac)
# CTX_DEMO_IAC_DIR=

# --- Primary stack: Meta Model API + Modal (+ optional RunPod) -------------
# With only META_API_KEY (+ the Modal sandbox) set, the router runs first-class:
#   Tier 1A hover        open-weight muse-glimmer-30b (if set) -> Meta API muse-spark-1.3
#   Tier 1B catalog      open-weight muse-glimmer-30b (if set) -> Meta API muse-spark-1.3 (minimal effort)
#   Tier 2  correlate    Meta API muse-spark-1.3 (low effort; escalation when Tier 1B fails or is invalid)
#   Tier 3A remediate    Meta API muse-wonder-1.0 plans and writes the bundle (muse-code when served)
#   Tier 3B pre-flight   Modal sandbox (CTX_MODAL_SANDBOX_URL) -> local pwsh AST + terraform validate

# --- Meta Model API ($150 credit) ------------------------------------------
# Served on 2026-10-26: muse-spark-1.3, muse-spark-1.3-contributor, muse-wonder-1.0, muse-voice-transcribe-1.0.
# muse-glimmer-30b and muse-code are not served there; at startup the orchestrator checks GET /models and
# swaps an unserved id for its stand-in (muse-code -> muse-wonder-1.0, muse-glimmer-30b -> muse-spark-1.3).
META_API_BASE_URL=https://api.meta.ai/v1
# MODEL_API_KEY is accepted as an alias
META_API_KEY=
CTX_MODEL_META_HOVER=muse-spark-1.3
# CTX_MODEL_META_CATALOG=muse-spark-1.3-contributor also works but needs ~22 s for a layout (raise CTX_CORRELATE_TIMEOUT_MS to 35000)
CTX_MODEL_META_CATALOG=muse-spark-1.3
CTX_MODEL_META_SPARK=muse-spark-1.3
CTX_MODEL_META_WONDER=muse-wonder-1.0
CTX_MODEL_META_CODE=muse-code
CTX_MODEL_META_VOICE=muse-voice-transcribe-1.0
# Tier 2 · Vision: the ticket screenshot is sent as an image_url part (POST /api/vision-extract)
CTX_MODEL_META_VISION=muse-spark-1.3
# reasoning_effort per tier: minimal | low | medium | high
CTX_META_REASONING_HOVER=minimal
CTX_META_REASONING_CATALOG=minimal
CTX_META_REASONING_CORRELATE=low
CTX_META_REASONING_REMEDIATE=low

# --- Modal ($100 credit) ----------------------------------------------------
# Tier 3B pre-flight sandbox: modal deploy modal-sandbox/contextpane_sandbox.py
CTX_MODAL_SANDBOX_URL=
CTX_MODAL_SANDBOX_TOKEN=
# Empty = on whenever CTX_MODAL_SANDBOX_URL is set; false disables it explicitly
CTX_MODAL_SANDBOX_ENABLED=
# Optional open-weight Muse Glimmer 30B on Modal: pwsh ./scripts/Start-GlimmerOpenWeights.ps1
# (llama-server + the 16.8 GB GGUF on an L40S; sets this to the OpenAI-compatible base URL, ending in /v1)
MODAL_INFERENCE_BASE_URL=

# --- RunPod (optional) ------------------------------------------------------
# vLLM pod started with scripts/Start-RunPodGlimmer.ps1, e.g. https://<pod-id>-8000.proxy.runpod.net/v1
RUNPOD_VLLM_BASE_URL=

# --- Open-weight endpoint (Tier 1A / 1B first choice) ------------------------
# Defaults to MODAL_INFERENCE_BASE_URL, then RUNPOD_VLLM_BASE_URL; set it to point anywhere else.
# Telemetry provider: http://127.0.0.1:<port>/v1 (scripts/Start-GlimmerOpenWeights.ps1 -Target Local) logs
# local-glimmer-30b, a RunPod URL runpod, anything else modal-open-weights
CTX_OPEN_WEIGHT_BASE_URL=
# Bearer token if vLLM was started with --api-key
CTX_OPEN_WEIGHT_API_KEY=
# --served-model-name of the vLLM server(s)
CTX_MODEL_OPEN_WEIGHT_GLIMMER=muse-glimmer-30b
CTX_MODEL_OPEN_WEIGHT_CATALOG=muse-glimmer-30b
# Tiers the open-weight endpoint serves: hover, catalog, voice (comma-separated). Hover only by default so
# correlates never wake the GPU; hover answers persist to data/hover-cache.json across restarts
# (a fresh clone seeds it from the tracked data/hover-cache.seed.json)
CTX_OPEN_WEIGHT_TIERS=hover

# --- Optional drop-in overrides ----------------------------------------------
# Baseten: open-weight muse-spark-open-1026 for Tier 1B, glimmer for Tier 1A
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_API_KEY=
CTX_MODEL_BASETEN_SPARK=meta-models/muse-spark-open-1026
CTX_MODEL_BASETEN_GLIMMER=muse-glimmer-30b
# Fireworks AI: Tier 1A hover ahead of Baseten and Meta when keyed
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_API_KEY=
CTX_MODEL_FIREWORKS_GLIMMER=accounts/fireworks/models/muse-glimmer-30b

# --- Router behaviour ------------------------------------------------------
# Per-provider timeout before falling to the next provider in the chain
CTX_HOVER_TIMEOUT_MS=2500
# Meta's reasoning models need ~1.5-2.5 s for a hover even at minimal effort
CTX_META_HOVER_TIMEOUT_MS=5000
# Muse Glimmer always reasons (llama-server caps it with --reasoning-budget), so it gets its own budget
CTX_OPEN_WEIGHT_HOVER_TIMEOUT_MS=8000
# Background hover pre-warm against the open-weight endpoint (covers a cold GPU container)
CTX_OPEN_WEIGHT_WARM_TIMEOUT_MS=90000
# max_tokens for a Glimmer hover, reasoning included (llama-server does not enforce --reasoning-budget)
CTX_OPEN_WEIGHT_HOVER_MAX_TOKENS=3000
CTX_CORRELATE_TIMEOUT_MS=20000
CTX_REMEDIATE_TIMEOUT_MS=45000
CTX_VISION_TIMEOUT_MS=30000
# Force the deterministic engine even when keys are present (demo safety switch)
CTX_FORCE_LOCAL=false
# Also run the approved PowerShell via pwsh on approval. Off: LIVE_CLOUD_MODE approvals only update the lab users' license extension.
CTX_ALLOW_EXECUTE=false
# Where staged remediation branches are created (git worktree under this dir)
CTX_STAGING_DIR=.contextpane/staging

# --- Demo lab identifiers (used by scripts/ and the offline manifest) -------
CTX_LAB_TENANT_ID=4cc41c20-8b01-40a3-93c6-b4f1e846f6ea
CTX_LAB_SUBSCRIPTION_ID=20505597-043c-4742-a884-42dc3f621aef
CTX_LAB_DOMAIN=c4a8shili.onmicrosoft.com
CTX_LAB_LOCATION=westeurope

# --- GitHub (Tier 3 HITL → real pull request) ------------------------------
# true -> [Approve & Execute] force-pushes the ticket's fix/<ticket>-<tenant>-remediation branch and returns its
#         open PR, or runs `gh pr create` when there is none
#         (needs a remote origin, see scripts/Publish-ContextPaneRepo.ps1, and an authenticated gh CLI).
#         The approval drawer also has a per-approval checkbox; it defaults to this value.
CTX_GH_PR_ON_APPROVE=false
CTX_GH_PR_BASE=main

# --- Router savings panel ---------------------------------------------------
# Blended $ per 1M tokens used only to estimate "API credit saved" by Tier 0 recipes
CTX_PRICE_USD_PER_1M_TOKENS=1.00
