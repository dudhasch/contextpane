# ---------------------------------------------------------------------------
# ContextPane — environment template
# Copy to .env.local (git-ignored) or run: pwsh ./scripts/Set-ContextPaneRouterConfig.ps1
# Every key is optional. With no keys set, every tier falls back to the
# deterministic local engine, so the workbench works out of the box.
# ---------------------------------------------------------------------------

# --- Ports -----------------------------------------------------------------
CTX_ORCHESTRATOR_PORT=4000
CTX_WEB_PORT=5173
# 127.0.0.1 on purpose: on Windows "localhost" resolves to ::1 first and the IPv6 fallback costs ~2 s per request
CTX_ORCHESTRATOR_URL=http://127.0.0.1:4000

# --- Cloud mode ------------------------------------------------------------
# true  -> mcp-msgraph / mcp-azure-iac shell out to PowerShell 7 (Microsoft.Graph, Az).
#          One cached Connect-AzAccount sign-in is enough: mcp-msgraph mints a Graph token
#          from the Az token cache when no Connect-MgGraph context exists.
# false -> read ./demo-iac/demo-lab-manifest.json (deterministic, offline-safe)
LIVE_CLOUD_MODE=false
# Per-query budgets for the live pwsh calls (ms); a timed-out query falls back to the manifest
CTX_GRAPH_TIMEOUT_MS=25000
CTX_AZ_TIMEOUT_MS=25000
# auditLogs/signIns filtered by UPN is slow on big tenants and the lab users never sign in
CTX_GRAPH_SIGNIN_TIMEOUT_MS=6000
# Path override for the offline manifest (defaults to <repo>/demo-iac/demo-lab-manifest.json)
# CTX_DEMO_MANIFEST=
# Path override for the Terraform baseline directory (defaults to <repo>/demo-iac)
# CTX_DEMO_IAC_DIR=

# --- Primary stack: Meta Model API + Modal (+ optional RunPod) -------------
# With only META_API_KEY (+ the Modal sandbox) set, the router runs first-class:
#   Tier 1A hover        open-weight vLLM (if set) -> Meta API muse-glimmer-30b
#   Tier 1B catalog      open-weight vLLM (if set) -> Meta API muse-spark-1.3-contributor
#   Tier 2  correlate    Meta API muse-spark-1.3 (escalation when Tier 1B fails or is invalid)
#   Tier 3A remediate    Meta API muse-wonder-1.0 plans, muse-code writes the bundle
#   Tier 3B pre-flight   Modal sandbox (CTX_MODAL_SANDBOX_URL) -> local pwsh AST + terraform validate

# --- Meta Model API ($150 credit) ------------------------------------------
META_API_BASE_URL=https://api.meta.ai/v1
# MODEL_API_KEY is accepted as an alias
META_API_KEY=
CTX_MODEL_META_SPARK=muse-spark-1.3
CTX_MODEL_META_SPARK_CONTRIBUTOR=muse-spark-1.3-contributor
CTX_MODEL_META_WONDER=muse-wonder-1.0
CTX_MODEL_META_CODE=muse-code
CTX_MODEL_META_GLIMMER=muse-glimmer-30b
CTX_MODEL_META_VOICE=muse-voice-transcribe

# --- Modal ($100 credit) ----------------------------------------------------
# Tier 3B pre-flight sandbox: modal deploy modal-sandbox/contextpane_sandbox.py
CTX_MODAL_SANDBOX_URL=
CTX_MODAL_SANDBOX_TOKEN=
# Empty = on whenever CTX_MODAL_SANDBOX_URL is set; false disables it explicitly
CTX_MODAL_SANDBOX_ENABLED=
# Optional open-weight muse-glimmer-30b on Modal: modal deploy modal-sandbox/open_weights_vllm.py
# (the OpenAI-compatible base URL, ending in /v1)
MODAL_INFERENCE_BASE_URL=

# --- RunPod (optional) ------------------------------------------------------
# vLLM pod started with scripts/Start-RunPodGlimmer.ps1, e.g. https://<pod-id>-8000.proxy.runpod.net/v1
RUNPOD_VLLM_BASE_URL=

# --- Open-weight endpoint (Tier 1A / 1B first choice) ------------------------
# Defaults to MODAL_INFERENCE_BASE_URL, then RUNPOD_VLLM_BASE_URL; set it to point anywhere else
CTX_OPEN_WEIGHT_BASE_URL=
# Bearer token if vLLM was started with --api-key
CTX_OPEN_WEIGHT_API_KEY=
# --served-model-name of the vLLM server(s)
CTX_MODEL_OPEN_WEIGHT_GLIMMER=muse-glimmer-30b
CTX_MODEL_OPEN_WEIGHT_CATALOG=muse-glimmer-30b

# --- Optional drop-in overrides ----------------------------------------------
# Baseten: open-weight muse-spark-open-1026 for Tier 1B, glimmer for Tier 1A
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_API_KEY=
CTX_MODEL_BASETEN_SPARK=meta-models/muse-spark-open-1026
CTX_MODEL_BASETEN_GLIMMER=muse-glimmer-30b
# Fireworks AI: Tier 1A hover ahead of Baseten and Meta when keyed
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_API_KEY=
CTX_MODEL_FIREWORKS_GLIMMER=accounts/fireworks/models/muse-glimmer-30b

# --- Router behaviour ------------------------------------------------------
# Per-provider timeout before falling to the next provider in the chain
CTX_HOVER_TIMEOUT_MS=2500
CTX_CORRELATE_TIMEOUT_MS=20000
CTX_REMEDIATE_TIMEOUT_MS=45000
# Force the deterministic engine even when keys are present (demo safety switch)
CTX_FORCE_LOCAL=false
# Allow /api/approve to actually execute the remediation script via pwsh (default: -WhatIf simulation only)
CTX_ALLOW_EXECUTE=false
# Where staged remediation branches are created (git worktree under this dir)
CTX_STAGING_DIR=.contextpane/staging

# --- Demo lab identifiers (used by scripts/ and the offline manifest) -------
CTX_LAB_TENANT_ID=4cc41c20-8b01-40a3-93c6-b4f1e846f6ea
CTX_LAB_SUBSCRIPTION_ID=20505597-043c-4742-a884-42dc3f621aef
CTX_LAB_DOMAIN=c4a8shili.onmicrosoft.com
CTX_LAB_LOCATION=westeurope

# --- GitHub (Tier 3 HITL → real pull request) ------------------------------
# true -> [Approve & Execute] pushes the staged fix/<ticket>-nsg-drift-<id> branch and runs `gh pr create`
#         (needs a remote origin, see scripts/Publish-ContextPaneRepo.ps1, and an authenticated gh CLI).
#         The approval drawer also has a per-approval checkbox; it defaults to this value.
CTX_GH_PR_ON_APPROVE=false
CTX_GH_PR_BASE=main

# --- Router savings panel ---------------------------------------------------
# Blended $ per 1M tokens used only to estimate "API credit saved" by Tier 0 recipes
CTX_PRICE_USD_PER_1M_TOKENS=1.00
