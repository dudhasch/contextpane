# ---------------------------------------------------------------------------
# ContextPane — environment template
# Copy to .env.local (git-ignored) or run: pwsh ./scripts/Set-ContextPaneRouterConfig.ps1
# Every key is optional. With no keys set, every tier falls back to the
# deterministic local engine, so the workbench works out of the box.
# ---------------------------------------------------------------------------

# --- Ports -----------------------------------------------------------------
CTX_ORCHESTRATOR_PORT=4000
CTX_WEB_PORT=5173
# 127.0.0.1 on purpose: on Windows "localhost" resolves to ::1 first and the IPv6 fallback costs ~2 s per request
CTX_ORCHESTRATOR_URL=http://127.0.0.1:4000

# --- Cloud mode ------------------------------------------------------------
# true  -> mcp-msgraph / mcp-azure-iac shell out to PowerShell 7 (Microsoft.Graph, Az)
# false -> read ./demo-iac/demo-lab-manifest.json (deterministic, offline-safe)
LIVE_CLOUD_MODE=false
# Path override for the offline manifest (defaults to <repo>/demo-iac/demo-lab-manifest.json)
# CTX_DEMO_MANIFEST=
# Path override for the Terraform baseline directory (defaults to <repo>/demo-iac)
# CTX_DEMO_IAC_DIR=

# --- Meta Model API (Tier 1A fallback, Tier 2, Tier 3A/3B) ------------------
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
CTX_MODEL_META_SPARK=muse-spark-1.3
CTX_MODEL_META_SPARK_CONTRIBUTOR=muse-spark-1.3-contributor
CTX_MODEL_META_WONDER=muse-wonder-1.0
CTX_MODEL_META_CODE=muse-code
CTX_MODEL_META_GLIMMER=muse-glimmer-30b
CTX_MODEL_META_VOICE=muse-voice-transcribe

# --- Baseten (Tier 1B/2 primary, Tier 1A secondary) ------------------------
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_API_KEY=
CTX_MODEL_BASETEN_SPARK=meta-models/muse-spark-open-1026
CTX_MODEL_BASETEN_GLIMMER=muse-glimmer-30b

# --- Fireworks AI (Tier 1A primary) ----------------------------------------
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_API_KEY=
CTX_MODEL_FIREWORKS_GLIMMER=accounts/fireworks/models/muse-glimmer-30b

# --- Modal pre-flight sandbox (Tier 3B) ------------------------------------
CTX_MODAL_SANDBOX_ENABLED=false
CTX_MODAL_SANDBOX_URL=
CTX_MODAL_SANDBOX_TOKEN=

# --- Router behaviour ------------------------------------------------------
# Per-provider timeout before falling to the next provider in the chain
CTX_HOVER_TIMEOUT_MS=2500
CTX_CORRELATE_TIMEOUT_MS=20000
CTX_REMEDIATE_TIMEOUT_MS=45000
# Force the deterministic engine even when keys are present (demo safety switch)
CTX_FORCE_LOCAL=false
# Allow /api/approve to actually execute the remediation script via pwsh (default: -WhatIf simulation only)
CTX_ALLOW_EXECUTE=false
# Where staged remediation branches are created (git worktree under this dir)
CTX_STAGING_DIR=.contextpane/staging

# --- Demo lab identifiers (used by scripts/ and the offline manifest) -------
CTX_LAB_TENANT_ID=4cc41c20-8b01-40a3-93c6-b4f1e846f6ea
CTX_LAB_SUBSCRIPTION_ID=20505597-043c-4742-a884-42dc3f621aef
CTX_LAB_DOMAIN=c4a8shili.onmicrosoft.com
CTX_LAB_LOCATION=westeurope
